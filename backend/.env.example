# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vd_assistant?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3001
NODE_ENV=development

# AI Services
COMFYUI_URL="http://localhost:8188"
OLLAMA_URL="http://localhost:11434"

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:3000"

# Upload settings
MAX_FILE_SIZE=10485760
UPLOAD_DIR="./uploads"

# AI API Keys (All free tier — get keys from respective dashboards)
GOOGLE_API_KEY=        # https://aistudio.google.com/apikey (free 10 RPM / 500 RPD)
REPLICATE_API_TOKEN=   # https://replicate.com/account/api-tokens (free credits on signup)
HUGGINGFACE_API_KEY=   # https://huggingface.co/settings/tokens (free tier)
